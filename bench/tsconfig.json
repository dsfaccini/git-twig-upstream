{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"],
    "skipLibCheck": true
  },
  "include": [
    "run.ts",
    "lib/**/*.ts",
    "suites/**/*.ts",
    "linux-*/target.ts",
    "tests/**/*.ts"
  ]
}
